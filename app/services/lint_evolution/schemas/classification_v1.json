{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lint_evolution.classification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_kind",
    "category",
    "false_positive_risk",
    "detector_type",
    "scope_subjectivity",
    "duplicate_of_active",
    "extends_active",
    "test_generatable",
    "confidence",
    "notes"
  ],
  "properties": {
    "rule_kind": {
      "type": "string",
      "enum": [
        "tests_failing",
        "syntax_error",
        "missing_implementation",
        "no_evidence_provided",
        "unused_imports",
        "circular_dependency",
        "dead_code_present",
        "test_timeout",
        "acceptance_criteria_unmet",
        "logic_error",
        "__unknown__"
      ]
    },
    "category": {
      "type": "string",
      "enum": ["correctness", "security", "architecture", "style", "performance"]
    },
    "false_positive_risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "detector_type": {
      "type": "string",
      "enum": ["regex", "ast", "shell", "llm_only"]
    },
    "scope_subjectivity": {
      "type": "string",
      "enum": ["objective", "context_dependent", "subjective"]
    },
    "duplicate_of_active": {"type": ["string", "null"]},
    "extends_active": {"type": ["string", "null"]},
    "test_generatable": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {"type": "string", "maxLength": 500}
  }
}
